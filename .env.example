# Copy to .env on the VPS; never commit the populated file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
TELEGRAM_ADMIN_CHAT_ID=
# Optional public HTTPS welcome image; blank uses the local text menu.
WELCOME_IMAGE_URL=
# Full Socket.IO auth frame. Use a dedicated Demo account for the shared feed.
PO_SSID=
AUTOTRADE_FEED_SSID=
# Preserve your existing Neon URL and its TLS parameters.
DATABASE_URL=
# Preserve the existing vault key: changing it makes saved sessions unreadable.
AUTOTRADE_VAULT_KEY=
# Same JWT secret for bot and engine, at least 32 characters.
AUTOTRADE_JWT_SECRET=
AUTOTRADE_API_URL=http://127.0.0.1:8100
# REQUIRED for Telegram login: your real HTTPS domain, served by the VPS TLS proxy.
AUTOTRADE_PUBLIC_URL=
AUTOTRADE_ALLOW_LIVE=1
AUTOTRADE_HOST=127.0.0.1
AUTOTRADE_PORT=8100
# Bot health server; private on the VPS.
HOST=127.0.0.1
PORT=5000
FORWARDED_ALLOW_IPS=127.0.0.1,::1
AUTOTRADE_TRUST_PROXY=0
# Full browser behavior by default. Opt in to smaller-memory behavior if needed.
AUTOTRADE_LOW_MEMORY=0
AUTOTRADE_CHROMIUM_SINGLE_PROCESS=0
AUTOTRADE_BLOCK_LOGIN_ASSETS=0
AUTOTRADE_MAX_HANDSHAKES=1
AUTOTRADE_DB_STATEMENT_TIMEOUT_MS=15000
AUTOTRADE_DB_LOCK_TIMEOUT_MS=5000
AUTOTRADE_DB_IDLE_TRANSACTION_TIMEOUT_MS=30000
